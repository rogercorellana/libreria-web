@{
    ViewBag.Title = "Backup";
}

<div class="container-fluid">

    <h2>Backup de la base de datos</h2>
    <p>
        Desde esta sección el Webmaster puede generar
        una copia de respaldo de la base de datos.
    </p>

    @if (TempData["BackupExitoso"] != null)
    {
        <div class="alert alert-success">
            @TempData["BackupExitoso"]
        </div>
    }

    @if (TempData["BackupError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["BackupError"]
        </div>
    }

    @using (Html.BeginForm(
        "EjecutarBackup",
        "Webmaster",
        FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-primary">
            Realizar backup
        </button>
    }

</div>
